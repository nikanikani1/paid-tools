{
  "name": "paid-tools",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:voice": "npm run dev --workspace=@paid/voice",
    "dev:headshot": "npm run dev --workspace=@paid/headshot",
    "dev:photo": "npm run dev --workspace=@paid/photo-studio",
    "build:voice": "npm run build --workspace=@paid/voice",
    "build:headshot": "npm run build --workspace=@paid/headshot",
    "build:photo": "npm run build --workspace=@paid/photo-studio",
    "build": "npm run build:voice && npm run build:headshot && npm run build:photo",
    "typecheck": "tsc --noEmit -p apps/voice/tsconfig.json && tsc --noEmit -p apps/headshot/tsconfig.json && tsc --noEmit -p apps/photo-studio/tsconfig.json",
    "cf:build:voice": "npm run cf:build --workspace=@paid/voice",
    "cf:build:headshot": "npm run cf:build --workspace=@paid/headshot",
    "cf:build:photo": "npm run cf:build --workspace=@paid/photo-studio",
    "cf:deploy:voice": "npm run cf:deploy --workspace=@paid/voice",
    "cf:deploy:headshot": "npm run cf:deploy --workspace=@paid/headshot",
    "cf:deploy:photo": "npm run cf:deploy --workspace=@paid/photo-studio",
    "cf:preview:voice": "npm run cf:preview --workspace=@paid/voice",
    "cf:preview:headshot": "npm run cf:preview --workspace=@paid/headshot",
    "db:generate": "prisma generate --schema packages/core/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/core/prisma/schema.prisma"
  },
  "overrides": {
    "magic-string": "0.30.21"
  },
  "devDependencies": {
    "magic-string": "0.30.21"
  }
}
